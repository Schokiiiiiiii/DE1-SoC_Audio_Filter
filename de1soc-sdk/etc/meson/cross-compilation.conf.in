# Note: Buildroot's and Meson's terminologies differ about the meaning
# of 'build', 'host' and 'target':
# - Buildroot's 'host' is Meson's 'build'
# - Buildroot's 'target' is Meson's 'host'

[binaries]
c = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/bin/arm-linux-gnueabihf-gcc'
cpp = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/bin/arm-linux-gnueabihf-g++'
ar = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/bin/arm-linux-gnueabihf-gcc-ar'
strip = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/bin/arm-linux-gnueabihf-strip'
cmake = '/usr/bin/cmake'
pkgconfig = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/bin/pkgconf'
g-ir-compiler = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/arm-buildroot-linux-gnueabihf/sysroot/usr/bin/g-ir-compiler'
g-ir-scanner = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/arm-buildroot-linux-gnueabihf/sysroot/usr/bin/g-ir-scanner'

[built-in options]
c_args = ['-D_LARGEFILE_SOURCE', '-D_LARGEFILE64_SOURCE', '-D_FILE_OFFSET_BITS=64', '-Os', '-g0'@PKG_TARGET_CFLAGS@]
c_link_args = [@PKG_TARGET_LDFLAGS@]
cpp_args = ['-D_LARGEFILE_SOURCE', '-D_LARGEFILE64_SOURCE', '-D_FILE_OFFSET_BITS=64', '-Os', '-g0'@PKG_TARGET_CXXFLAGS@]
cpp_link_args = [@PKG_TARGET_LDFLAGS@]
wrap_mode = 'nodownload'
cmake_prefix_path = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/arm-buildroot-linux-gnueabihf/sysroot/usr/lib/cmake'

[properties]
needs_exe_wrapper = true
sys_root = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/arm-buildroot-linux-gnueabihf/sysroot'
pkg_config_libdir = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/arm-buildroot-linux-gnueabihf/sysroot/usr/lib/pkgconfig:/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/arm-buildroot-linux-gnueabihf/sysroot/usr/share/pkgconfig'
pkg_config_static = 'false'
# enable meson build to pass a toolchain file to cmake
cmake_toolchain_file = '/home/schoki/Documents/HEIG-VD/Semestre4/PTR/de1soc-sdk/share/buildroot/toolchainfile.cmake'
cmake_defaults = false

[host_machine]
system = 'linux'
cpu_family = 'arm'
cpu = 'cortex-a9'
endian = 'little'
